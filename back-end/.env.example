# Porta do servidor (Render define automaticamente)
PORT=3333

# URL do PostgreSQL no Render
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/dj_decor?schema=public"

# URL do frontend na Vercel (CORS)
# Desenvolvimento: http://localhost:3000
# Produção: https://seu-app.vercel.app
FRONTEND_URL="http://localhost:3000"

# Ambiente
NODE_ENV=development

# Segredo usado para assinar os tokens JWT (mínimo 16 caracteres)
# Gere um valor forte em produção, ex: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-forte-com-no-minimo-16-caracteres"

# Tempo de expiração do token JWT
JWT_EXPIRES_IN="7d"

# Percentual padrão de comissão do vendedor ao confirmar pagamento (ex.: 5 = 5%)
COMISSAO_PERCENTUAL_DEFAULT=5

# URL do projeto paralelo de IA / WhatsApp (opcional).
# Se definida, o adapter encaminha disparos para esse endpoint.
# WHATSAPP_IA_WEBHOOK_URL="https://seu-projeto-ia.onrender.com/webhooks/dj-decor"
