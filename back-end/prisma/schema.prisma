generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  VENDEDOR
  MONTADOR
}

enum StatusFesta {
  ORCAMENTO
  AGUARDANDO_PAGAMENTO
  PAGO
  FECHADO
  EM_MONTAGEM
  CONCLUIDO
  CANCELADO
}

enum TamanhoDecoracao {
  P
  M
  G
  GG
}

enum StatusUnidade {
  DISPONIVEL
  RESERVADA
  EM_USO
  MANUTENCAO
}

enum StatusPagamento {
  PENDENTE
  CONFIRMADO
  ESTORNADO
}

enum TipoPagamento {
  PIX
  DINHEIRO
  CARTAO
  OUTRO
}

enum StatusOS {
  ABERTA
  ROMANEIO
  EM_TRANSITO
  CHECKIN
  FINALIZADA
}

enum TipoMidia {
  REFERENCIA_FESTA
  CLIENTE_REFERENCIA
  ITEM
  COMPROVANTE_PIX
  MONTAGEM_FINAL
  CONTRATO
  LOGO_EMPRESA
  CATALOGO_ITEM
  ASSINATURA_CLIENTE
}

enum TipoCatalogoAddon {
  ADDON
  EXTRA_METROS
}

enum TipoMovimentacao {
  SAIDA_GALPAO
  ENTRADA_RETORNO
}

enum StatusComissao {
  PENDENTE
  PAGA
  CANCELADA
}

enum StatusMensagemWhatsApp {
  PENDENTE
  ENVIADA
  FALHA
}

enum StatusDesconto {
  NENHUM
  PENDENTE
  APROVADO
  RECUSADO
}

model User {
  id     String  @id @default(cuid())
  nome   String  @unique
  email  String? @unique
  senha  String
  role   Role    @default(VENDEDOR)
  ativo  Boolean @default(true)

  festas                    Festa[]            @relation("FestaVendedor")
  midiasUploaded            Midia[]            @relation("MidiaUploadedBy")
  ordensServico             OrdemServico[]     @relation("OsMontador")
  comissoes                 Comissao[]
  movimentacoesQr           MovimentacaoQr[]
  descontosSolicitados      Festa[]            @relation("DescontoSolicitadoPor")
  descontosAprovados        Festa[]            @relation("DescontoAprovadoPor")
  followUpsRegistrados      FollowUpContato[]

  @@map("users")
}

model Cliente {
  id       String  @id @default(cuid())
  nome     String
  telefone String
  festas   Festa[]

  @@map("clientes")
}

model Festa {
  id                    String            @id @default(cuid())
  dataEvento            DateTime          @map("data_evento")
  horarioMontagem       DateTime          @map("horario_montagem")
  status                StatusFesta       @default(ORCAMENTO)
  valor                 Decimal           @db.Decimal(10, 2)
  tema                  String
  tamanhoDecoracao      TamanhoDecoracao  @map("tamanho_decoracao")
  itensExtras           String[]          @default([]) @map("itens_extras")
  itensExtrasConcluidos String[]          @default([]) @map("itens_extras_concluidos")
  kitCatalogo           String?           @map("kit_catalogo")
  pegueEMonte           Boolean           @default(false) @map("pegue_e_monte")
  observacoes           String?           @db.Text
  endereco              String
  alertaCompraEstoque   Boolean           @default(false) @map("alerta_compra_estoque")
  itensFaltaEstoque     String[]          @default([]) @map("itens_falta_estoque")
  portalToken           String?           @unique @map("portal_token")
  assinaturaClienteEm   DateTime?         @map("assinatura_cliente_em")
  avaliacaoNota         Int?              @map("avaliacao_nota")
  avaliacaoComentario   String?           @map("avaliacao_comentario") @db.Text
  avaliacaoEm           DateTime?         @map("avaliacao_em")
  criadoEm              DateTime          @default(now()) @map("criado_em")

  clienteId  String @map("cliente_id")
  cliente    Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String @map("vendedor_id")
  vendedor   User   @relation("FestaVendedor", fields: [vendedorId], references: [id])

  valorOriginal           Decimal?       @map("valor_original") @db.Decimal(10, 2)
  descontoPercentual      Decimal?       @map("desconto_percentual") @db.Decimal(5, 2)
  descontoStatus          StatusDesconto @default(NENHUM) @map("desconto_status")
  descontoSolicitadoPorId String?        @map("desconto_solicitado_por_id")
  descontoSolicitadoPor   User?          @relation("DescontoSolicitadoPor", fields: [descontoSolicitadoPorId], references: [id])
  descontoAprovadoPorId   String?        @map("desconto_aprovado_por_id")
  descontoAprovadoPor     User?          @relation("DescontoAprovadoPor", fields: [descontoAprovadoPorId], references: [id])

  reservasEstoque   ReservaEstoque[]
  pagamentos        Pagamento[]
  comissoes         Comissao[]
  ordemServico      OrdemServico?
  midias            Midia[]
  contrato          Contrato?
  mensagensWhatsApp MensagemWhatsApp[]
  followUps         FollowUpContato[]

  @@map("festas")
}

model Produto {
  id           String   @id @default(cuid())
  nome         String
  categoria    String
  valorAluguel Decimal  @map("valor_aluguel") @db.Decimal(10, 2)
  tema         String?
  requerQr     Boolean  @default(false) @map("requer_qr")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")

  unidades UnidadeProduto[]

  @@map("produtos")
}

model UnidadeProduto {
  id       String        @id @default(cuid())
  codigoQr String        @unique @map("codigo_qr")
  etiqueta String?
  status   StatusUnidade @default(DISPONIVEL)

  produtoId String  @map("produto_id")
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  reservas      ReservaEstoque[]
  itensRomaneio ItemRomaneio[]
  movimentacoes MovimentacaoQr[]

  @@index([produtoId, status])
  @@map("unidades_produto")
}

model ReservaEstoque {
  id       String   @id @default(cuid())
  inicio   DateTime
  fim      DateTime
  criadoEm DateTime @default(now()) @map("criado_em")

  festaId String @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  unidadeId String         @map("unidade_id")
  unidade   UnidadeProduto @relation(fields: [unidadeId], references: [id], onDelete: Restrict)

  @@index([unidadeId, inicio, fim])
  @@index([festaId])
  @@map("reservas_estoque")
}

model Pagamento {
  id           String          @id @default(cuid())
  valor        Decimal         @db.Decimal(10, 2)
  tipo         TipoPagamento   @default(PIX)
  status       StatusPagamento @default(PENDENTE)
  confirmadoEm DateTime?       @map("confirmado_em")
  criadoEm     DateTime        @default(now()) @map("criado_em")

  /** Campos para PIX automático (PSP) — preenchidos quando integrado. */
  pixTxid      String?   @map("pix_txid")
  pixQrCode    String?   @map("pix_qr_code") @db.Text
  pixCopiaCola String?   @map("pix_copia_cola") @db.Text
  pixExpiresAt DateTime? @map("pix_expires_at")

  festaId String @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  comprovanteMidiaId String? @unique @map("comprovante_midia_id")
  comprovanteMidia   Midia?  @relation("PagamentoComprovante", fields: [comprovanteMidiaId], references: [id])

  @@index([festaId])
  @@index([pixTxid])
  @@map("pagamentos")
}

model Comissao {
  id         String         @id @default(cuid())
  percentual Decimal        @db.Decimal(5, 2)
  valor      Decimal        @db.Decimal(10, 2)
  status     StatusComissao @default(PENDENTE)
  pagoEm     DateTime?      @map("pago_em")
  criadoEm   DateTime       @default(now()) @map("criado_em")

  festaId String @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  vendedorId String @map("vendedor_id")
  vendedor   User   @relation(fields: [vendedorId], references: [id])

  @@index([vendedorId])
  @@index([festaId])
  @@map("comissoes")
}

model OrdemServico {
  id                String    @id @default(cuid())
  status            StatusOS  @default(ABERTA)
  checkinLat        Float?    @map("checkin_lat")
  checkinLng        Float?    @map("checkin_lng")
  checkinAt         DateTime? @map("checkin_at")
  romaneioConcluido Boolean   @default(false) @map("romaneio_concluido")
  criadoEm          DateTime  @default(now()) @map("criado_em")

  festaId String @unique @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  montadorId String? @map("montador_id")
  montador   User?   @relation("OsMontador", fields: [montadorId], references: [id])

  itensRomaneio   ItemRomaneio[]
  movimentacoesQr MovimentacaoQr[]

  @@map("ordens_servico")
}

model ItemRomaneio {
  id         String  @id @default(cuid())
  descricao  String?
  carregado  Boolean @default(false)
  conferido  Boolean @default(false)

  osId String       @map("os_id")
  os   OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  unidadeId String?         @map("unidade_id")
  unidade   UnidadeProduto? @relation(fields: [unidadeId], references: [id])

  fotoMidiaId String? @map("foto_midia_id")
  fotoMidia   Midia?  @relation("ItemRomaneioFoto", fields: [fotoMidiaId], references: [id])

  @@index([osId])
  @@map("itens_romaneio")
}

model Midia {
  id        String    @id @default(cuid())
  data      Bytes
  mimeType  String    @map("mime_type")
  tamanho   Int
  tipo      TipoMidia
  filename  String?
  criadoEm  DateTime  @default(now()) @map("criado_em")

  festaId String? @map("festa_id")
  festa   Festa?  @relation(fields: [festaId], references: [id], onDelete: SetNull)

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation("MidiaUploadedBy", fields: [uploadedById], references: [id])

  pagamentoComprovante Pagamento?     @relation("PagamentoComprovante")
  itemRomaneioFoto     ItemRomaneio[] @relation("ItemRomaneioFoto")
  catalogoKits         CatalogoKit[]  @relation("CatalogoKitImagem")
  catalogoAddons       CatalogoAddon[] @relation("CatalogoAddonImagem")
  configuracaoLogo     ConfiguracaoNegocio? @relation("ConfigLogo")

  @@index([festaId])
  @@index([tipo])
  @@map("midias")
}

model MovimentacaoQr {
  id       String           @id @default(cuid())
  tipo     TipoMovimentacao
  lat      Float?
  lng      Float?
  criadoEm DateTime         @default(now()) @map("criado_em")

  unidadeId String         @map("unidade_id")
  unidade   UnidadeProduto @relation(fields: [unidadeId], references: [id])

  osId String?       @map("os_id")
  os   OrdemServico? @relation(fields: [osId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@index([unidadeId])
  @@index([osId])
  @@map("movimentacoes_qr")
}

model Contrato {
  id       String   @id @default(cuid())
  pdfData  Bytes?   @map("pdf_data")
  pdfUrl   String?  @map("pdf_url")
  hash     String?
  geradoEm DateTime @default(now()) @map("gerado_em")

  festaId String @unique @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  @@map("contratos")
}

model MensagemWhatsApp {
  id         String                  @id @default(cuid())
  template   String
  telefone   String?
  payload    Json?
  providerId String?                 @map("provider_id")
  status     StatusMensagemWhatsApp  @default(PENDENTE)
  erro       String?
  criadoEm   DateTime                @default(now()) @map("criado_em")
  enviadoEm  DateTime?               @map("enviado_em")

  festaId String? @map("festa_id")
  festa   Festa?  @relation(fields: [festaId], references: [id], onDelete: SetNull)

  @@index([festaId])
  @@map("mensagens_whatsapp")
}

/** Singleton de configurações de negócio (sempre id = "default"). */
model ConfiguracaoNegocio {
  id                   String   @id @default("default")
  comissaoPercentual   Decimal  @default(5) @map("comissao_percentual") @db.Decimal(5, 2)
  comissaoMetaSemanal  Decimal  @default(500) @map("comissao_meta_semanal") @db.Decimal(10, 2)
  clausulasContrato    String?  @map("clausulas_contrato") @db.Text
  nomeEmpresa          String   @default("DJ Decor") @map("nome_empresa")
  sloganEmpresa        String   @default("Decoração de Festas · Locação de Materiais") @map("slogan_empresa")
  atualizadoEm         DateTime @updatedAt @map("atualizado_em")

  logoMidiaId String? @unique @map("logo_midia_id")
  logoMidia   Midia?  @relation("ConfigLogo", fields: [logoMidiaId], references: [id], onDelete: SetNull)

  @@map("configuracao_negocio")
}

model CatalogoKit {
  id               String            @id
  nome             String
  categoria        String
  descricaoCurta   String            @map("descricao_curta")
  valorEquipe      Decimal           @map("valor_equipe") @db.Decimal(10, 2)
  valorPegueEMonte Decimal?          @map("valor_pegue_e_monte") @db.Decimal(10, 2)
  tamanhoSugerido  TamanhoDecoracao  @map("tamanho_sugerido")
  itens            String[]          @default([])
  ativo            Boolean           @default(true)
  ordem            Int               @default(0)
  criadoEm         DateTime          @default(now()) @map("criado_em")

  imagemMidiaId String? @map("imagem_midia_id")
  imagemMidia   Midia?  @relation("CatalogoKitImagem", fields: [imagemMidiaId], references: [id], onDelete: SetNull)

  @@map("catalogo_kits")
}

model CatalogoAddon {
  id     String            @id
  nome   String
  valor  Decimal           @db.Decimal(10, 2)
  tipo   TipoCatalogoAddon @default(ADDON)
  ativo  Boolean           @default(true)
  ordem  Int               @default(0)
  criadoEm DateTime        @default(now()) @map("criado_em")

  imagemMidiaId String? @map("imagem_midia_id")
  imagemMidia   Midia?  @relation("CatalogoAddonImagem", fields: [imagemMidiaId], references: [id], onDelete: SetNull)

  @@map("catalogo_addons")
}

model FollowUpContato {
  id        String   @id @default(cuid())
  canal     String   @default("WHATSAPP")
  nota      String?  @db.Text
  criadoEm  DateTime @default(now()) @map("criado_em")

  festaId String @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@index([festaId])
  @@map("follow_up_contatos")
}
