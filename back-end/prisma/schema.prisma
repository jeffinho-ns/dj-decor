generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  VENDEDOR
  MONTADOR
}

enum StatusFesta {
  ORCAMENTO
  FECHADO
  CONCLUIDO
}

enum TamanhoDecoracao {
  P
  M
  G
  GG
}

model User {
  id     String  @id @default(cuid())
  nome   String  @unique
  email  String? @unique
  senha  String
  role   Role    @default(VENDEDOR)
  festas Festa[]

  @@map("users")
}

model Cliente {
  id       String  @id @default(cuid())
  nome     String
  telefone String
  festas   Festa[]

  @@map("clientes")
}

model Festa {
  id                String            @id @default(cuid())
  dataEvento        DateTime          @map("data_evento")
  horarioMontagem   DateTime          @map("horario_montagem")
  status            StatusFesta       @default(ORCAMENTO)
  valor             Decimal           @db.Decimal(10, 2)
  tema              String
  tamanhoDecoracao  TamanhoDecoracao  @map("tamanho_decoracao")
  itensExtras       String[]          @default([]) @map("itens_extras")
  endereco          String
  criadoEm          DateTime          @default(now()) @map("criado_em")

  clienteId  String @map("cliente_id")
  cliente    Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String @map("vendedor_id")
  vendedor   User   @relation(fields: [vendedorId], references: [id])

  @@map("festas")
}
