generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  VENDEDOR
  MONTADOR
  BOLISTA
}

enum StatusFesta {
  ORCAMENTO
  AGUARDANDO_PAGAMENTO
  PAGO
  FECHADO
  EM_MONTAGEM
  CONCLUIDO
  CANCELADO
}

enum TamanhoDecoracao {
  P
  M
  G
  GG
}

enum StatusUnidade {
  DISPONIVEL
  RESERVADA
  EM_USO
  MANUTENCAO
}

enum StatusPagamento {
  PENDENTE
  CONFIRMADO
  ESTORNADO
}

enum TipoPagamento {
  PIX
  DINHEIRO
  CARTAO
  OUTRO
}

enum StatusOS {
  ABERTA
  ROMANEIO
  EM_TRANSITO
  CHECKIN
  FINALIZADA
}

enum TipoMidia {
  REFERENCIA_FESTA
  CLIENTE_REFERENCIA
  ITEM
  COMPROVANTE_PIX
  MONTAGEM_FINAL
  /** Galeria Instagram — fotos (Firebase Storage). */
  MONTAGEM_FOTO
  /** Galeria Instagram — vídeos (Firebase Storage). */
  MONTAGEM_VIDEO
  CONTRATO
  LOGO_EMPRESA
  CATALOGO_ITEM
  ASSINATURA_CLIENTE
  REFERENCIA_BOLAS
}

enum TipoCatalogoAddon {
  ADDON
  EXTRA_METROS
  EXTRA_CASAMENTO
}

enum TipoMovimentacao {
  SAIDA_GALPAO
  ENTRADA_RETORNO
}

enum StatusComissao {
  PENDENTE
  PAGA
  CANCELADA
}

enum TipoRepasse {
  COMISSAO_VENDEDOR
  COMISSAO_SOCIA
  COMISSAO_DONA
  DIARIA_MONTAGEM
  DIARIA_DESMONTAGEM
}

enum StatusMensagemWhatsApp {
  PENDENTE
  ENVIADA
  FALHA
}

enum CanalAtendimento {
  WHATSAPP
  INSTAGRAM
  MANUAL
}

enum ModoAtendimento {
  AI
  HUMANO
  HIBRIDO
}

enum StatusConversa {
  ABERTA
  AGUARDANDO
  FECHADA
}

enum DirecaoMensagem {
  IN
  OUT
}

enum TipoAtendimentoEvento {
  CRIADA
  MENSAGEM
  HANDOFF
  TAKEOVER
  DEVOLVER_IA
  TOOL_CALL
  TOOL_RESULT
  FECHADA
  ATRIBUICAO
  NOTA_INTERNA
}

enum StatusDesconto {
  NENHUM
  PENDENTE
  APROVADO
  RECUSADO
}

enum FrequenciaPagamentoEquipe {
  SEMANAL
  QUINZENAL
  MENSAL
}

enum StatusPedidoBolas {
  RASCUNHO
  CONFIRMADO
  EM_MONTAGEM
  MONTADO
  DESMONTADO
  CONCLUIDO
  CANCELADO
}

enum StatusRepasseBolas {
  PENDENTE
  PAGO
}

model User {
  id                  String   @id @default(cuid())
  nome                String   @unique
  email               String?  @unique
  telefone            String?
  senha               String
  role                Role     @default(VENDEDOR)
  ativo               Boolean  @default(true)
  /** Sócia — recebe % configurável por festa quitada. */
  ehSocia             Boolean  @default(false) @map("eh_socia")
  /** Se preenchido, só gera comissão de sócia em festas cuja venda foi fechada (vendaEm) nesta data ou depois. */
  sociaDesde          DateTime? @map("socia_desde")
  /** Dona — recebe o restante do valor após vendedor e sócias. */
  ehDona              Boolean  @default(false) @map("eh_dona")
  /** Meta individual de comissão semanal (R$). Null = usa meta global da empresa. */
  comissaoMetaSemanal Decimal? @map("comissao_meta_semanal") @db.Decimal(10, 2)

  festas                    Festa[]            @relation("FestaVendedor")
  festasMontadorEquipe      Festa[]            @relation("FestaMontadorEquipe")
  festasDesmontadorEquipe   Festa[]            @relation("FestaDesmontadorEquipe")
  midiasUploaded            Midia[]            @relation("MidiaUploadedBy")
  ordensServico             OrdemServico[]     @relation("OsMontador")
  ordensServicoDesmontagem  OrdemServico[]     @relation("OsDesmontador")
  comissoes                 Comissao[]
  movimentacoesQr           MovimentacaoQr[]
  descontosSolicitados      Festa[]            @relation("DescontoSolicitadoPor")
  descontosAprovados        Festa[]            @relation("DescontoAprovadoPor")
  followUpsRegistrados      FollowUpContato[]
  conversasAtribuidas       Conversa[]           @relation("ConversaVendedor")
  eventosAtendimento        AtendimentoEvento[]  @relation("AtendimentoEventoAutor")
  pedidosBolas              PedidoBolas[]      @relation("PedidoBolasBolista")
  catalogoBolasCriados      CatalogoBola[]     @relation("CatalogoBolaCriadoPor")

  @@map("users")
}

model Cliente {
  id           String   @id @default(cuid())
  nome         String
  telefone     String
  observacoes  String?  @db.Text
  /** Instagram, Indicacao, WhatsApp, Salao, Google, Outro */
  origem       String?
  tags         String[] @default([])
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  festas       Festa[]
  conversas    Conversa[]

  @@index([telefone])
  @@map("clientes")
}

model Festa {
  id                    String            @id @default(cuid())
  dataEvento            DateTime          @map("data_evento")
  horarioMontagem       DateTime          @map("horario_montagem")
  status                StatusFesta       @default(ORCAMENTO)
  valor                 Decimal           @db.Decimal(10, 2)
  tema                  String
  tamanhoDecoracao      TamanhoDecoracao  @map("tamanho_decoracao")
  itensExtras           String[]          @default([]) @map("itens_extras")
  itensExtrasConcluidos String[]          @default([]) @map("itens_extras_concluidos")
  kitCatalogo           String?           @map("kit_catalogo")
  pegueEMonte           Boolean           @default(false) @map("pegue_e_monte")
  observacoes           String?           @db.Text
  /** Trocas pedidas pelo cliente (mesa, cilindros, etc.) — visível para a equipe. */
  notasInternas         String?           @map("notas_internas") @db.Text
  endereco              String
  /** true = festa fora de Paracambi (Suellem: 30% montagem; sem diária local). */
  foraParacambi         Boolean           @default(false) @map("fora_paracambi")
  alertaCompraEstoque   Boolean           @default(false) @map("alerta_compra_estoque")
  itensFaltaEstoque     String[]          @default([]) @map("itens_falta_estoque")
  portalToken           String?           @unique @map("portal_token")
  assinaturaClienteEm   DateTime?         @map("assinatura_cliente_em")
  avaliacaoNota         Int?              @map("avaliacao_nota")
  avaliacaoComentario   String?           @map("avaliacao_comentario") @db.Text
  avaliacaoEm           DateTime?         @map("avaliacao_em")
  /** Momento em que a festa ficou quitada (soma de pagamentos confirmados >= valor). */
  quitadoEm             DateTime?         @map("quitado_em")
  /** Momento em que a venda foi fechada/lançada no sistema (pipeline antigo fica antes da sócia nova). */
  vendaEm               DateTime          @default(now()) @map("venda_em")
  criadoEm              DateTime          @default(now()) @map("criado_em")

  clienteId  String @map("cliente_id")
  cliente    Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String @map("vendedor_id")
  vendedor   User   @relation("FestaVendedor", fields: [vendedorId], references: [id])

  /** Equipe prevista — qualquer usuário ativo (vendedor também pode montar/desmontar). */
  montadorEquipeId String? @map("montador_equipe_id")
  montadorEquipe   User?   @relation("FestaMontadorEquipe", fields: [montadorEquipeId], references: [id], onDelete: SetNull)
  desmontadorEquipeId String? @map("desmontador_equipe_id")
  desmontadorEquipe   User?   @relation("FestaDesmontadorEquipe", fields: [desmontadorEquipeId], references: [id], onDelete: SetNull)
  /** true = carro próprio; false = carro da empresa. */
  montadorCarroProprio     Boolean @default(true) @map("montador_carro_proprio")
  desmontadorCarroProprio  Boolean @default(true) @map("desmontador_carro_proprio")

  valorOriginal           Decimal?       @map("valor_original") @db.Decimal(10, 2)
  descontoPercentual      Decimal?       @map("desconto_percentual") @db.Decimal(5, 2)
  descontoStatus          StatusDesconto @default(NENHUM) @map("desconto_status")
  descontoSolicitadoPorId String?        @map("desconto_solicitado_por_id")
  descontoSolicitadoPor   User?          @relation("DescontoSolicitadoPor", fields: [descontoSolicitadoPorId], references: [id])
  descontoAprovadoPorId   String?        @map("desconto_aprovado_por_id")
  descontoAprovadoPor     User?          @relation("DescontoAprovadoPor", fields: [descontoAprovadoPorId], references: [id])

  reservasEstoque   ReservaEstoque[]
  pagamentos        Pagamento[]
  comissoes         Comissao[]
  ordemServico      OrdemServico?
  midias            Midia[]
  contrato          Contrato?
  mensagensWhatsApp MensagemWhatsApp[]
  followUps         FollowUpContato[]
  mensagensCanal    MensagemCanal[]
  conversas         Conversa[]
  pedidoBolas       PedidoBolas?

  @@map("festas")
}

model Produto {
  id           String   @id @default(cuid())
  nome         String
  categoria    String
  valorAluguel Decimal  @map("valor_aluguel") @db.Decimal(10, 2)
  tema         String?
  requerQr     Boolean  @default(false) @map("requer_qr")
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")

  unidades UnidadeProduto[]

  @@map("produtos")
}

model UnidadeProduto {
  id       String        @id @default(cuid())
  codigoQr String        @unique @map("codigo_qr")
  etiqueta String?
  status   StatusUnidade @default(DISPONIVEL)

  produtoId String  @map("produto_id")
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  reservas      ReservaEstoque[]
  itensRomaneio ItemRomaneio[]
  movimentacoes MovimentacaoQr[]

  @@index([produtoId, status])
  @@map("unidades_produto")
}

model ReservaEstoque {
  id       String   @id @default(cuid())
  inicio   DateTime
  fim      DateTime
  criadoEm DateTime @default(now()) @map("criado_em")

  festaId String @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  unidadeId String         @map("unidade_id")
  unidade   UnidadeProduto @relation(fields: [unidadeId], references: [id], onDelete: Restrict)

  @@index([unidadeId, inicio, fim])
  @@index([festaId])
  @@map("reservas_estoque")
}

model Pagamento {
  id           String          @id @default(cuid())
  valor        Decimal         @db.Decimal(10, 2)
  tipo         TipoPagamento   @default(PIX)
  status       StatusPagamento @default(PENDENTE)
  confirmadoEm DateTime?       @map("confirmado_em")
  criadoEm     DateTime        @default(now()) @map("criado_em")

  /** Campos para PIX automático (PSP) — preenchidos quando integrado. */
  pixTxid      String?   @map("pix_txid")
  pixQrCode    String?   @map("pix_qr_code") @db.Text
  pixCopiaCola String?   @map("pix_copia_cola") @db.Text
  pixExpiresAt DateTime? @map("pix_expires_at")

  festaId String @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  comprovanteMidiaId String? @unique @map("comprovante_midia_id")
  comprovanteMidia   Midia?  @relation("PagamentoComprovante", fields: [comprovanteMidiaId], references: [id])

  @@index([festaId])
  @@index([pixTxid])
  @@map("pagamentos")
}

model Comissao {
  id         String         @id @default(cuid())
  tipo       TipoRepasse    @default(COMISSAO_VENDEDOR)
  percentual Decimal?       @db.Decimal(5, 2)
  valor      Decimal        @db.Decimal(10, 2)
  status     StatusComissao @default(PENDENTE)
  pagoEm     DateTime?      @map("pago_em")
  /** Início do mês da festa — só pode ser pago a partir desta data. */
  elegivelEm DateTime       @default(now()) @map("elegivel_em")
  /** Dia civil (fuso BR) da diária — 1 pagamento por pessoa/tipo/dia. */
  diaReferencia DateTime?   @map("dia_referencia")
  criadoEm   DateTime       @default(now()) @map("criado_em")

  festaId String @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  /** Beneficiário do repasse (vendedor, sócia, dona, montador ou desmontador). */
  beneficiarioId String @map("beneficiario_id")
  beneficiario   User   @relation(fields: [beneficiarioId], references: [id])

  @@unique([festaId, beneficiarioId, tipo])
  @@index([beneficiarioId])
  @@index([festaId])
  @@index([status, elegivelEm])
  @@index([beneficiarioId, tipo, diaReferencia])
  @@map("comissoes")
}

model OrdemServico {
  id                String    @id @default(cuid())
  status            StatusOS  @default(ABERTA)
  checkinLat        Float?    @map("checkin_lat")
  checkinLng        Float?    @map("checkin_lng")
  checkinAt         DateTime? @map("checkin_at")
  romaneioConcluido         Boolean   @default(false) @map("romaneio_concluido")
  montagemLocalConcluida    Boolean   @default(false) @map("montagem_local_concluida")
  criadoEm                  DateTime  @default(now()) @map("criado_em")

  festaId String @unique @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  montadorId String? @map("montador_id")
  montador   User?   @relation("OsMontador", fields: [montadorId], references: [id])

  desmontadorId String? @map("desmontador_id")
  desmontador   User?   @relation("OsDesmontador", fields: [desmontadorId], references: [id])
  montadorCarroProprio     Boolean @default(true) @map("montador_carro_proprio")
  desmontadorCarroProprio  Boolean @default(true) @map("desmontador_carro_proprio")

  itensRomaneio   ItemRomaneio[]
  movimentacoesQr MovimentacaoQr[]

  @@map("ordens_servico")
}

model ItemRomaneio {
  id         String  @id @default(cuid())
  descricao  String?
  carregado  Boolean @default(false)
  conferido  Boolean @default(false)
  montado    Boolean @default(false) @map("montado")

  osId String       @map("os_id")
  os   OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  unidadeId String?         @map("unidade_id")
  unidade   UnidadeProduto? @relation(fields: [unidadeId], references: [id])

  fotoMidiaId String? @map("foto_midia_id")
  fotoMidia   Midia?  @relation("ItemRomaneioFoto", fields: [fotoMidiaId], references: [id])

  @@index([osId])
  @@map("itens_romaneio")
}

model Midia {
  id        String    @id @default(cuid())
  /** Conteúdo embutido (legado). Galeria de montagem usa storagePath. */
  data      Bytes?
  mimeType  String    @map("mime_type")
  tamanho   Int
  tipo      TipoMidia
  filename  String?
  /** Path no Firebase Storage (ex.: festas/{id}/montagem/{midiaId}.jpg). */
  storagePath    String?  @map("storage_path")
  /** Se false, não aparece no portal do cliente. */
  visivelPortal  Boolean  @default(true) @map("visivel_portal")
  ordem          Int      @default(0)
  criadoEm  DateTime  @default(now()) @map("criado_em")

  festaId String? @map("festa_id")
  festa   Festa?  @relation(fields: [festaId], references: [id], onDelete: SetNull)

  pedidoBolasId String?      @map("pedido_bolas_id")
  pedidoBolas   PedidoBolas? @relation(fields: [pedidoBolasId], references: [id], onDelete: SetNull)

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation("MidiaUploadedBy", fields: [uploadedById], references: [id])

  pagamentoComprovante Pagamento?     @relation("PagamentoComprovante")
  itemRomaneioFoto     ItemRomaneio[] @relation("ItemRomaneioFoto")
  catalogoKits         CatalogoKit[]  @relation("CatalogoKitImagem")
  catalogoAddons       CatalogoAddon[] @relation("CatalogoAddonImagem")
  configuracaoLogo     ConfiguracaoNegocio? @relation("ConfigLogo")

  @@index([festaId])
  @@index([pedidoBolasId])
  @@index([tipo])
  @@map("midias")
}

model MovimentacaoQr {
  id       String           @id @default(cuid())
  tipo     TipoMovimentacao
  lat      Float?
  lng      Float?
  criadoEm DateTime         @default(now()) @map("criado_em")

  unidadeId String         @map("unidade_id")
  unidade   UnidadeProduto @relation(fields: [unidadeId], references: [id])

  osId String?       @map("os_id")
  os   OrdemServico? @relation(fields: [osId], references: [id], onDelete: SetNull)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@index([unidadeId])
  @@index([osId])
  @@map("movimentacoes_qr")
}

model Contrato {
  id       String   @id @default(cuid())
  pdfData  Bytes?   @map("pdf_data")
  pdfUrl   String?  @map("pdf_url")
  hash     String?
  geradoEm DateTime @default(now()) @map("gerado_em")

  festaId String @unique @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  @@map("contratos")
}

model MensagemWhatsApp {
  id         String                  @id @default(cuid())
  template   String
  telefone   String?
  payload    Json?
  providerId String?                 @map("provider_id")
  status     StatusMensagemWhatsApp  @default(PENDENTE)
  erro       String?
  criadoEm   DateTime                @default(now()) @map("criado_em")
  enviadoEm  DateTime?               @map("enviado_em")

  festaId String? @map("festa_id")
  festa   Festa?  @relation(fields: [festaId], references: [id], onDelete: SetNull)

  @@index([festaId])
  @@map("mensagens_whatsapp")
}

/** Singleton de configurações de negócio (sempre id = "default"). */
model ConfiguracaoNegocio {
  id                      String   @id @default("default")
  /** % do vendedor sobre o valor da festa (default 10). */
  comissaoPercentual      Decimal  @default(10) @map("comissao_percentual") @db.Decimal(5, 2)
  /** % de cada sócia sobre o valor da festa (default 30). */
  comissaoSociaPercentual Decimal  @default(30) @map("comissao_socia_percentual") @db.Decimal(5, 2)
  comissaoMetaSemanal     Decimal  @default(500) @map("comissao_meta_semanal") @db.Decimal(10, 2)
  /** Diária montagem com carro próprio (default R$150). */
  diariaMontador          Decimal  @default(150) @map("diaria_montador") @db.Decimal(10, 2)
  /** Diária desmontagem com carro próprio (default R$130). */
  diariaDesmontador       Decimal  @default(130) @map("diaria_desmontador") @db.Decimal(10, 2)
  diariaMontadorCarroEmpresa     Decimal @default(130) @map("diaria_montador_carro_empresa") @db.Decimal(10, 2)
  diariaDesmontadorCarroEmpresa  Decimal @default(80) @map("diaria_desmontador_carro_empresa") @db.Decimal(10, 2)
  /** Ritmo de pagamento das diárias (dá para mudar a qualquer momento). */
  frequenciaPagamentoEquipe FrequenciaPagamentoEquipe @default(QUINZENAL) @map("frequencia_pagamento_equipe")
  /** % em cima da tabela do profissional de bolas (cliente paga tabela × (1 + markup/100)). */
  markupBolasPercentual   Decimal  @default(10) @map("markup_bolas_percentual") @db.Decimal(5, 2)
  clausulasContrato       String?  @map("clausulas_contrato") @db.Text
  nomeEmpresa             String   @default("DJ festas") @map("nome_empresa")
  sloganEmpresa           String   @default("Decoração de Festas · Locação de Materiais") @map("slogan_empresa")
  telefoneEmpresa         String?  @map("telefone_empresa")
  whatsappEmpresa         String?  @map("whatsapp_empresa")
  enderecoEmpresa         String?  @map("endereco_empresa")
  atualizadoEm            DateTime @updatedAt @map("atualizado_em")

  logoMidiaId String? @unique @map("logo_midia_id")
  logoMidia   Midia?  @relation("ConfigLogo", fields: [logoMidiaId], references: [id], onDelete: SetNull)

  @@map("configuracao_negocio")
}

model CatalogoKit {
  id               String            @id
  nome             String
  categoria        String
  descricaoCurta   String            @map("descricao_curta")
  valorEquipe      Decimal           @map("valor_equipe") @db.Decimal(10, 2)
  valorPegueEMonte Decimal?          @map("valor_pegue_e_monte") @db.Decimal(10, 2)
  tamanhoSugerido  TamanhoDecoracao  @map("tamanho_sugerido")
  itens            String[]          @default([])
  ativo            Boolean           @default(true)
  ordem            Int               @default(0)
  criadoEm         DateTime          @default(now()) @map("criado_em")

  imagemMidiaId String? @map("imagem_midia_id")
  imagemMidia   Midia?  @relation("CatalogoKitImagem", fields: [imagemMidiaId], references: [id], onDelete: SetNull)

  @@map("catalogo_kits")
}

model CatalogoAddon {
  id     String            @id
  nome   String
  valor  Decimal           @db.Decimal(10, 2)
  tipo   TipoCatalogoAddon @default(ADDON)
  ativo  Boolean           @default(true)
  ordem  Int               @default(0)
  criadoEm DateTime        @default(now()) @map("criado_em")

  imagemMidiaId String? @map("imagem_midia_id")
  imagemMidia   Midia?  @relation("CatalogoAddonImagem", fields: [imagemMidiaId], references: [id], onDelete: SetNull)

  @@map("catalogo_addons")
}

model FollowUpContato {
  id               String    @id @default(cuid())
  canal            String    @default("WHATSAPP")
  nota             String?   @db.Text
  proximoContatoEm DateTime? @map("proximo_contato_em")
  criadoEm         DateTime  @default(now()) @map("criado_em")

  festaId String @map("festa_id")
  festa   Festa  @relation(fields: [festaId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@index([festaId])
  @@index([proximoContatoEm])
  @@map("follow_up_contatos")
}

/** Thread de atendimento omnicanal (WhatsApp / Instagram / manual). */
model Conversa {
  id               String           @id @default(cuid())
  canal            CanalAtendimento @default(WHATSAPP)
  /** ID externo do contato/thread no provedor (ex.: wa_id / IGSID). */
  externalThreadId String           @map("external_thread_id")
  /** Telefone ou handle exibido. */
  contatoExterno   String?          @map("contato_externo")
  contatoNome      String?          @map("contato_nome")
  modo             ModoAtendimento  @default(AI)
  status           StatusConversa   @default(ABERTA)
  ultimaMensagemEm DateTime?        @map("ultima_mensagem_em")
  resumo           String?          @db.Text
  /** Notas da equipe (não vão para o cliente). Espelha a festa vinculada. */
  notasInternas    String?          @map("notas_internas") @db.Text
  criadoEm         DateTime         @default(now()) @map("criado_em")
  atualizadoEm     DateTime         @updatedAt @map("atualizado_em")

  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  vendedorId String? @map("vendedor_id")
  vendedor   User?   @relation("ConversaVendedor", fields: [vendedorId], references: [id], onDelete: SetNull)

  festaId String? @map("festa_id")
  festa   Festa?  @relation(fields: [festaId], references: [id], onDelete: SetNull)

  mensagens MensagemCanal[]
  eventos   AtendimentoEvento[]

  @@unique([canal, externalThreadId])
  @@index([status, ultimaMensagemEm])
  @@index([vendedorId])
  @@index([clienteId])
  @@map("conversas")
}

model MensagemCanal {
  id                String          @id @default(cuid())
  direcao           DirecaoMensagem
  texto             String?         @db.Text
  midiaUrl          String?         @map("midia_url")
  midiaMimeType     String?         @map("midia_mime_type")
  providerMessageId String?         @unique @map("provider_message_id")
  statusEnvio       String?         @map("status_envio")
  autorTipo         String          @default("CLIENTE") @map("autor_tipo")
  criadoEm          DateTime        @default(now()) @map("criado_em")

  conversaId String   @map("conversa_id")
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  festaId String? @map("festa_id")
  festa   Festa?  @relation(fields: [festaId], references: [id], onDelete: SetNull)

  @@index([conversaId, criadoEm])
  @@map("mensagens_canal")
}

model AtendimentoEvento {
  id        String                @id @default(cuid())
  tipo      TipoAtendimentoEvento
  payload   Json?
  criadoEm  DateTime              @default(now()) @map("criado_em")

  conversaId String   @map("conversa_id")
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  autorId String? @map("autor_id")
  autor   User?   @relation("AtendimentoEventoAutor", fields: [autorId], references: [id], onDelete: SetNull)

  @@index([conversaId, criadoEm])
  @@map("atendimento_eventos")
}

/** Catálogo/tabela de preços do profissional de bolas (prestador). */
model CatalogoBola {
  id          String   @id @default(cuid())
  nome        String
  descricao   String?  @db.Text
  valorTabela Decimal  @map("valor_tabela") @db.Decimal(10, 2)
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  criadoEm    DateTime @default(now()) @map("criado_em")

  criadoPorId String? @map("criado_por_id")
  criadoPor   User?   @relation("CatalogoBolaCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  itensPedido PedidoBolasItem[]

  @@map("catalogo_bolas")
}

/** Pedido de bolas ligado a uma festa DJ Decor ou avulso (serviço externo). */
model PedidoBolas {
  id                   String              @id @default(cuid())
  dataEvento           DateTime            @map("data_evento")
  horarioMontagem      DateTime            @map("horario_montagem")
  horarioDesmontagem   DateTime?           @map("horario_desmontagem")
  tema                 String
  endereco             String
  clienteNome          String              @map("cliente_nome")
  clienteTelefone      String              @map("cliente_telefone")
  observacoes          String?             @db.Text
  cores                String?             @db.Text
  instrucoes           String?             @db.Text
  valorTabela          Decimal             @map("valor_tabela") @db.Decimal(10, 2)
  valorCliente         Decimal             @map("valor_cliente") @db.Decimal(10, 2)
  taxaEmpresa          Decimal             @map("taxa_empresa") @db.Decimal(10, 2)
  markupPercentual     Decimal             @map("markup_percentual") @db.Decimal(5, 2)
  status               StatusPedidoBolas   @default(CONFIRMADO)
  montagemConcluida    Boolean             @default(false) @map("montagem_concluida")
  desmontagemConcluida Boolean             @default(false) @map("desmontagem_concluida")
  statusPagamentoCliente StatusPagamento   @default(PENDENTE) @map("status_pagamento_cliente")
  statusRepasse        StatusRepasseBolas  @default(PENDENTE) @map("status_repasse")
  repassadoEm          DateTime?           @map("repassado_em")
  repasseObs           String?             @map("repasse_obs") @db.Text
  criadoEm             DateTime            @default(now()) @map("criado_em")
  atualizadoEm         DateTime            @updatedAt @map("atualizado_em")

  festaId String? @unique @map("festa_id")
  festa   Festa?  @relation(fields: [festaId], references: [id], onDelete: SetNull)

  bolistaId String @map("bolista_id")
  bolista   User   @relation("PedidoBolasBolista", fields: [bolistaId], references: [id])

  itens   PedidoBolasItem[]
  compras PedidoBolasCompra[]
  midias  Midia[]

  @@index([bolistaId, dataEvento])
  @@index([status])
  @@index([statusRepasse])
  @@map("pedidos_bolas")
}

model PedidoBolasItem {
  id               String  @id @default(cuid())
  nome             String
  quantidade       Int     @default(1)
  valorTabelaUnit  Decimal @map("valor_tabela_unit") @db.Decimal(10, 2)
  valorClienteUnit Decimal @map("valor_cliente_unit") @db.Decimal(10, 2)

  pedidoId String      @map("pedido_id")
  pedido   PedidoBolas @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  catalogoBolaId String?       @map("catalogo_bola_id")
  catalogoBola   CatalogoBola? @relation(fields: [catalogoBolaId], references: [id], onDelete: SetNull)

  @@index([pedidoId])
  @@map("pedido_bolas_itens")
}

/** Itens de compra do profissional (lista de mercado por pedido). */
model PedidoBolasCompra {
  id         String   @id @default(cuid())
  descricao  String
  quantidade String?
  comprado   Boolean  @default(false)
  criadoEm   DateTime @default(now()) @map("criado_em")

  pedidoId String      @map("pedido_id")
  pedido   PedidoBolas @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId, comprado])
  @@map("pedido_bolas_compras")
}
